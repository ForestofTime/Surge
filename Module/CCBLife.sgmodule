#!arguments-desc = splash: 开屏广告\nhome: 精选页广告\nlife: 生活页广告\nfinance: 金融页营销内容\nprofile: 我的页面广告\npopup: 页面弹窗\nrecommendation: 种草及信息流推荐\nicon_skin: 图标皮肤\nnewcomer: 新人礼包

[Script]
建行生活广告配置过滤 = type=http-response,pattern=^https:\/\/yunbusiness\.ccb\.com\/(?:basic_service|clp_service)\/txCtrl\?txcode=A3341(?:A009|AB03|A120|A095|MB22|A068|AB04|AB08|C147)(?:&|$),requires-body=true,max-size=1048576,timeout=20,script-path=https://raw.githubusercontent.com/ForestofTime/Surge/codex/ccb-life-ads-20260809/JS/CCBLifeAdBlock.js?v=1,script-arguments="splash=%splash&home=%home&life=%life&finance=%finance&profile=%profile&popup=%popup&recommendation=%recommendation&icon_skin=%icon_skin&newcomer=%newcomer"

[MITM]
hostname = %APPEND% yunbusiness.ccb.com
