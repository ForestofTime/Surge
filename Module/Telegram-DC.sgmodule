#!name=Telegram 优选 IP 覆盖
#!desc=绕开已验证劣化的 Telegram DC2/DC5 IP，强制改用同 DC 备用地址。
#!author=ForestofTime
#!category=连接优化
#!homepage=https://github.com/ForestofTime/Surge
#!raw-url=https://raw.githubusercontent.com/ForestofTime/Surge/main/Module/Telegram-DC.sgmodule

[General]
# 使 IP 字面量的 Host 覆盖也作用于经代理建立的连接。
use-local-host-item-for-proxy = true

[Host]
# 此模块只维护已验证的劣化地址，不能在 Surge 内部动态探测或评分 IP。
# 映射始终保持在同一 Telegram 数据中心，避免跨 DC 改写。

# DC2：95.161.76.100/31 曾在本配置中作为“防止 TG 转圈”地址被拦截。
# 149.154.167.51 是 TDLib 的 DC2 默认 TCP 端点。
95.161.76.100 = 149.154.167.51
95.161.76.101 = 149.154.167.51

# DC5：保留 FKTG 社区维护的已知劣化地址和优选地址池。
91.108.56.100 = 91.108.56.147,91.108.56.135,91.108.56.130
91.108.56.101 = 91.108.56.147,91.108.56.135,91.108.56.130
91.108.56.104 = 91.108.56.147,91.108.56.135,91.108.56.130
91.108.56.107 = 91.108.56.147,91.108.56.135,91.108.56.130
91.108.56.120 = 91.108.56.147,91.108.56.135,91.108.56.130
91.108.56.125 = 91.108.56.147,91.108.56.135,91.108.56.130
91.108.56.126 = 91.108.56.147,91.108.56.135,91.108.56.130
91.108.56.128 = 91.108.56.147,91.108.56.135,91.108.56.130
91.108.56.156 = 91.108.56.147,91.108.56.135,91.108.56.130
