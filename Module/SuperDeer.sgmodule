#!name=超鹿运动去开屏广告
#!desc=清理超鹿开屏素材数组，保留启动响应及业务字段。v3
#!author=ForestofTime
#!category=AdBlock
#!homepage=https://github.com/ForestofTime/Surge
#!raw-url=https://raw.githubusercontent.com/ForestofTime/Surge/main/Module/SuperDeer.sgmodule

[Body Rewrite]
http-response-jq ^https:\/\/app\.chaolu\.com\.cn\/app\/getSplashData\/V2(?:\?|$) 'if (.data.splashes | type) == "array" then .data.splashes = [] else . end'

[MITM]
hostname = %APPEND% app.chaolu.com.cn
