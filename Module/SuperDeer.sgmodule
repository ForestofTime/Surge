#!name=超鹿运动去开屏广告
#!desc=清空超鹿运动开屏配置的 data.splashes。v1
#!author=ForestofTime
#!category=AdBlock
#!homepage=https://github.com/ForestofTime/Surge
#!raw-url=https://raw.githubusercontent.com/ForestofTime/Surge/main/Module/SuperDeer.sgmodule

[Body Rewrite]
# HAR 已验证：POST /app/getSplashData/V2 的 data.splashes 是开屏素材和跳转入口。
http-response-jq ^https:\/\/app\.chaolu\.com\.cn\/app\/getSplashData\/V2(?:\?|$) 'if (.data | type) == "object" then .data.splashes = [] else . end'

[MITM]
hostname = %APPEND% app.chaolu.com.cn
