#!name=中国移动 autoLogin 自动同步
#!desc=转发中国移动 App 登录体，由 Mac 验号并同步青龙
#!author=ForestofTime
#!category=Automation
#!homepage=https://github.com/ForestofTime/Surge
#!raw-url=https://raw.githubusercontent.com/ForestofTime/Surge/main/Module/CMCCAutoLoginCapture.sgmodule
#!arguments = receiver_url:https://hynmac-mini.taila66285.ts.net/cmcc-autologin
#!arguments-desc = receiver_url: Mac 上已启用的 Tailnet 接收地址，请勿改为公网地址

[Script]
中国移动-autoLogin请求转发 = type=http-request,pattern=^https:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/LN\/[A-Za-z0-9_-]+\/autoLogin(?:\?.*)?$,requires-body=true,max-size=4096,timeout=5,engine=jsc,script-path=https://raw.githubusercontent.com/ForestofTime/Surge/main/JS/CMCCAutoLoginCapture.js?v=8,script-arguments="receiver_url=%receiver_url"
中国移动-autoLogin响应转发 = type=http-response,pattern=^https:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/LN\/[A-Za-z0-9_-]+\/autoLogin(?:\?.*)?$,requires-body=true,max-size=32768,full-header-mode=true,timeout=5,engine=jsc,script-path=https://raw.githubusercontent.com/ForestofTime/Surge/main/JS/CMCCAutoLoginCapture.js?v=8,script-arguments="receiver_url=%receiver_url"

[MITM]
hostname = %APPEND% client.app.coc.10086.cn
