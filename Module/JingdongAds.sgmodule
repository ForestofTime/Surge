#!name=京东去开屏
#!desc=仅处理京东 App 开屏图片和启动视频，不修改首页、购物车、我的页面或业务接口。v14
#!author=ForestofTime
#!category=AdBlock
#!homepage=https://github.com/ForestofTime/Surge
#!raw-url=https://raw.githubusercontent.com/ForestofTime/Surge/main/Module/JingdongAds.sgmodule

[Rule]
# 正常模式禁用开屏素材主机的 QUIC，使请求回落到可由 Map Local 或脚本处理的 HTTP/2。
AND, ((PROTOCOL, UDP), (DOMAIN, m.360buyimg.com)), REJECT
AND, ((PROTOCOL, UDP), (DOMAIN, vod.300hu.com)), REJECT

[Map Local]
# HAR 与真机已确认的开屏画布尺寸类路径，不依赖活动素材 ID。
^https?:\/\/m\.360buyimg\.com\/mobilecms\/s1125x2436_jfs(?:\/|$) data-type=text data=" " status-code=200

[Script]
# 只将数字业务路径 MP4 交给脚本，再用京东视频 UA 和启动播放器 Referer 二次校验后返回 204。
京东-主页面启动视频跳过 = type=http-request, pattern=^https?:\/\/vod\.300hu\.com\/\d+\/.*\.mp4(?:\?.*)?$, script-path=https://raw.githubusercontent.com/ForestofTime/Surge/main/JS/JingdongSplash.js?v=14, timeout=10

[MITM]
hostname = %APPEND% m.360buyimg.com, vod.300hu.com
tcp-connection = true
