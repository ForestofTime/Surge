#!name=京东去开屏
#!desc=清理京东开屏；可选拦截预加载，可能影响搜索视频。v23
#!author=ForestofTime
#!category=AdBlock
#!homepage=https://github.com/ForestofTime/Surge
#!raw-url=https://raw.githubusercontent.com/ForestofTime/Surge/main/Module/JingdongAds.sgmodule
#!arguments=search_preload:false
#!arguments-desc=实验选项：将 search_preload 设为 true 可拦截疑似开屏预加载，但可能影响搜索页视频；false 关闭。

[Rule]
# 正常模式禁用开屏素材主机的 QUIC，使请求回落到可由 Map Local 或脚本处理的 HTTP/2。
AND, ((PROTOCOL, UDP), (DOMAIN, m.360buyimg.com)), REJECT
AND, ((PROTOCOL, UDP), (DOMAIN, m15.360buyimg.com)), REJECT
AND, ((PROTOCOL, UDP), (DOMAIN, vod.300hu.com)), REJECT
AND, ((PROTOCOL, UDP), (DOMAIN, discover.300hu.com)), REJECT
AND, ((PROTOCOL, UDP), (DOMAIN, storage.360buyimg.com)), REJECT

[Map Local]
# Loon 抓包中的 HTTPDNS 空 404 语义，仅限已观测的两个路径。
^https:\/\/dns\.jd\.com\/v6\/[bd](?:\?|$) data-type=text data="" status-code=404
# 开屏画布尺寸类路径，不依赖活动素材 ID。
#
# 必须用 data-type=tiny-gif（返回一张 1x1 透明 GIF），不能用 data-type=text。
# 曾经用 data-type=text data=" " 返回 1 字节文本，被当成图片喂给 App：解码失败后
# App 回退到**本地缓存的旧开屏图**，于是规则明明命中、广告照旧显示。
# 返回合法的 1x1 透明 GIF 才能让解码成功、画面空白。
#
# 尺寸段是稳定的：开屏素材走 s<屏宽>x<屏高> 全屏类（竖屏手机分辨率），
# 而商品图是方形类（s714x714 等）。主机前缀会轮换（m. / m11. / m15. / img30.），
# 所以匹配尺寸类 + 主机家族，而不是写死某个主机。
^https?:\/\/(?:m|m\d{1,2}|img\d{1,2}|storage\d{0,2})\.360buyimg\.com\/mobilecms\/s(?:1125x2436|1170x2532|1242x2688|1284x2778|1290x2796|1320x2868)_jfs(?:\/|$)(?!.*\.avif(?:\?|$)) data-type=tiny-gif status-code=200

[Script]
# 社区开屏配置逻辑：兼容 URL/POST 入口和明文/Base64；脚本内校验开屏结构。
京东-开屏配置清理 = type=http-response, pattern=^https?:\/\/api\.m\.jd\.com\/client\.action(?:\?|$), script-path=https://raw.githubusercontent.com/ForestofTime/Surge/main/JS/JingdongSplashConfig.js?v=23, requires-body=true, max-size=2097152, timeout=10
# 三个主机的视频请求交脚本，脚本校验 UA、播放器及实验开关；默认主页面规则不变。
京东-主页面启动视频跳过 = type=http-request, pattern=^https?:\/\/vod\.300hu\.com\/[^?]*\.(?:mp4|m3u8|ts)(?:\?.*)?$, script-path=https://raw.githubusercontent.com/ForestofTime/Surge/main/JS/JingdongSplash.js?v=23, argument="{{{search_preload}}}", timeout=10
京东-主页面启动流跳过 = type=http-request, pattern=^https?:\/\/discover\.300hu\.com\/[^?]*\.(?:mp4|m3u8|ts)(?:\?.*)?$, script-path=https://raw.githubusercontent.com/ForestofTime/Surge/main/JS/JingdongSplash.js?v=23, argument="{{{search_preload}}}", timeout=10
京东-启动素材视频回退跳过 = type=http-request, pattern=^https?:\/\/storage\.360buyimg\.com\/[^?]*\.(?:mp4|m3u8|ts)(?:\?.*)?$, script-path=https://raw.githubusercontent.com/ForestofTime/Surge/main/JS/JingdongSplash.js?v=23, argument="{{{search_preload}}}", timeout=10
# AVIF 请求避开 GIF Map Local，由脚本返回透明 AVIF 二进制。
京东-开屏图AVIF跳过 = type=http-request, pattern=^https?:\/\/(?:m|m\d\d?|img\d\d?|storage\d?\d?)\.360buyimg\.com\/mobilecms\/s(?:1125x2436|1170x2532|1242x2688|1284x2778|1290x2796|1320x2868)_jfs\/.*\.avif(?:\?.*)?$, script-path=https://raw.githubusercontent.com/ForestofTime/Surge/main/JS/JingdongSplash.js?v=23, binary-body-mode=true, timeout=10

[MITM]
hostname = %APPEND% api.m.jd.com, dns.jd.com, m.360buyimg.com, m15.360buyimg.com, vod.300hu.com, discover.300hu.com, storage.360buyimg.com
tcp-connection = true
