#!name=京东去开屏
#!desc=仅拦截京东开屏图片和启动媒体，保留页面业务。v17
#!author=ForestofTime
#!category=AdBlock
#!homepage=https://github.com/ForestofTime/Surge
#!raw-url=https://raw.githubusercontent.com/ForestofTime/Surge/main/Module/JingdongAds.sgmodule

[Rule]
# 正常模式禁用开屏素材主机的 QUIC，使请求回落到可由 Map Local 或脚本处理的 HTTP/2。
AND, ((PROTOCOL, UDP), (DOMAIN, m.360buyimg.com)), REJECT
AND, ((PROTOCOL, UDP), (DOMAIN, m15.360buyimg.com)), REJECT
AND, ((PROTOCOL, UDP), (DOMAIN, vod.300hu.com)), REJECT
AND, ((PROTOCOL, UDP), (DOMAIN, discover.300hu.com)), REJECT

[Map Local]
# 开屏画布尺寸类路径，不依赖活动素材 ID。
#
# 必须用 data-type=tiny-gif（返回一张 1x1 透明 GIF），不能用 data-type=text。
# 曾经用 data-type=text data=" " 返回 1 字节文本，被当成图片喂给 App：解码失败后
# App 回退到**本地缓存的旧开屏图**，于是规则明明命中、广告照旧显示。
# 返回合法的 1x1 透明 GIF 才能让解码成功、画面空白。
#
# 尺寸段是稳定的：开屏素材走 s<屏宽>x<屏高> 全屏类（竖屏手机分辨率），
# 而商品图是方形类（s714x714 等）。主机前缀会轮换（m. / m11. / m15. / img30.），
# 所以匹配尺寸类 + 主机家族，而不是写死某个主机。
^https?:\/\/(?:m|m\d{1,2}|img\d{1,2}|storage\d{0,2})\.360buyimg\.com\/mobilecms\/s(?:1125x2436|1170x2532|1242x2688|1284x2778|1290x2796|1320x2868)_jfs(?:\/|$) data-type=tiny-gif status-code=200

[Script]
# 只将已确认的 MP4 与流媒体路径交给脚本，再用京东视频 UA 和启动播放器 Referer 二次校验后返回 204。
京东-主页面启动视频跳过 = type=http-request, pattern=^https?:\/\/vod\.300hu\.com\/\d+\/.*\.mp4(?:\?.*)?$, script-path=https://raw.githubusercontent.com/ForestofTime/Surge/main/JS/JingdongSplash.js?v=17, timeout=10
京东-主页面启动流跳过 = type=http-request, pattern=^https?:\/\/discover\.300hu\.com\/.*\.(?:m3u8|ts)(?:\?.*)?$, script-path=https://raw.githubusercontent.com/ForestofTime/Surge/main/JS/JingdongSplash.js?v=17, timeout=10
  # v17：开屏图 AVIF 分支。客户端升级后开屏图 URL 尾巴变 .jpg.avif/.png.avif，
  # Map Local 的 tiny-gif 无法被 AVIF 解码器接受 → App 回退本地缓存广告图 → 广告重现。
  # 由脚本返回合法 1x1 透明 AVIF（473 字节内嵌），解码成功 → 开屏空白消失。
  京东-开屏图AVIF跳过 = type=http-request, pattern=^https?:\/\/(?:m|m\d+|img\d+|storage\d+)\.360buyimg\.com\/mobilecms\/s(?:1125x2436|1170x2532|1242x2688|1284x2778|1290x2796|1320x2868)_jfs\/.*\.avif(?:\?.*)?$, script-path=https://raw.githubusercontent.com/ForestofTime/Surge/main/JS/JingdongSplash.js?v=17, timeout=10

[MITM]
hostname = %APPEND% m.360buyimg.com, m15.360buyimg.com, vod.300hu.com, discover.300hu.com
tcp-connection = true
