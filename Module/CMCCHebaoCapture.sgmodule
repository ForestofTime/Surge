#!name=和包悦看凭据抓取（Tailnet 同步）
#!desc=v7（2026-11-03）：临时取证版——把「和包-任务领奖抓包」放宽到全部 /activities/v1/ 请求（带 body），用于定位真机「领取」到底打哪个端点。v6 起新增该规则；v4 修 $response 未声明。功能：截和包 autoLogin 密文 / 大网 bigck / act_sid / opDfp 直写青龙 store。
#!author=ForestofTime
#!category=Automation
#!homepage=https://github.com/ForestofTime/Surge
#!raw-url=https://hynmac-mini.taila66285.ts.net/cmcc-hebao/module.sgmodule
#!arguments=receiver_url:https://hynmac-mini.taila66285.ts.net/cmcc-hebao,phone:15606946707
#!arguments-desc=receiver_url: Mac Tailnet receiver 地址（默认已内置 hynmac-mini/cmcc-hebao）。phone: 和包使用的移动手机号（用于 cred 落库标注，和包为单账号口径）。
#!icon=https://raw.githubusercontent.com/shindgewongxj/WHATINStash/main/icon/cmcc.png

[Script]
和包-凭据捕获 = type=http-request,pattern=^https?:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/LN\/uam(?:onekey|randcode)login\/autoLogin,requires-body=true,max-size=16384,timeout=30,engine=jsc,script-path=https://hynmac-mini.taila66285.ts.net/cmcc-hebao/js/CMCCHebaoCapture.js?v=7,script-arguments="receiver_url={{{receiver_url}}}&phone={{{phone}}}"
和包-大网token捕获 = type=http-request,pattern=^https?:\/\/p\.10086\.cn\/ptw\/arrtifact_get_mbl\.xhtml,requires-body=false,timeout=30,engine=jsc,script-path=https://hynmac-mini.taila66285.ts.net/cmcc-hebao/js/CMCCHebaoCapture.js?v=7,script-arguments="receiver_url={{{receiver_url}}}&phone={{{phone}}}"
和包-取票302捕获 = type=http-response,pattern=^https?:\/\/p\.10086\.cn\/ptw\/arrtifact_get_mbl\.xhtml,requires-body=false,timeout=30,engine=jsc,script-path=https://hynmac-mini.taila66285.ts.net/cmcc-hebao/js/CMCCHebaoCapture.js?v=7,script-arguments="receiver_url={{{receiver_url}}}&phone={{{phone}}}"
和包-活动会话捕获 = type=http-response,pattern=^https?:\/\/ump\.cmpay\.com\/activities\/v1\/login-common\/ssoTokenLogin,requires-body=false,timeout=30,engine=jsc,script-path=https://hynmac-mini.taila66285.ts.net/cmcc-hebao/js/CMCCHebaoCapture.js?v=7,script-arguments="receiver_url={{{receiver_url}}}&phone={{{phone}}}"
和包-设备指纹捕获 = type=http-request,pattern=^https?:\/\/ump\.cmpay\.com\/activities\/,requires-body=false,timeout=30,engine=jsc,script-path=https://hynmac-mini.taila66285.ts.net/cmcc-hebao/js/CMCCHebaoCapture.js?v=7,script-arguments="receiver_url={{{receiver_url}}}&phone={{{phone}}}"

和包-任务领奖抓包 = type=http-request,pattern=^https?:\/\/ump\.cmpay\.com\/activities\/v1\/,requires-body=true,max-size=32768,timeout=30,engine=jsc,script-path=https://hynmac-mini.taila66285.ts.net/cmcc-hebao/js/CMCCHebaoCapture.js?v=7,script-arguments="receiver_url={{{receiver_url}}}&phone={{{phone}}}"
和包-链路自检 = type=http-request,pattern=^https?:\/\/p\.10086\.cn\/?(?:\?.*)?$,requires-body=false,timeout=30,engine=jsc,script-path=https://hynmac-mini.taila66285.ts.net/cmcc-hebao/js/CMCCHebaoCapture.js?v=7,script-arguments="receiver_url={{{receiver_url}}}&phone={{{phone}}}"

[MITM]
hostname = %APPEND% client.app.coc.10086.cn, p.10086.cn, ump.cmpay.com
