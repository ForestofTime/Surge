#!name=环球运营球票据抓取（Tailnet 同步）
#!desc=抓 bmp.app.universalbeijingresort.com 的 ubr/user/login 响应，把 entity 票据回传 Mac，写入青龙 env hqyc_accs。v1
#!arguments-desc=receiver_url: Mac Tailnet 接收器地址（默认已内置 hynmac-mini/hqyc-capture，一般无需修改）

[Script]
环球运营球-登录票据 = type=http-response,pattern=^https?://bmp\.app\.universalbeijingresort\.com/2026_ubr_yunyingqiu/ubr/user/login,requires-body=true,max-size=65536,timeout=30,engine=jsc,script-path=https://hynmac-mini.taila66285.ts.net/hqyc-capture/js/HQYCCapture.js

[MITM]
hostname = bmp.app.universalbeijingresort.com
