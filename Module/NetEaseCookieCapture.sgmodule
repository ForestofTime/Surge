#!name=网易云云贝凭据抓取（Tailnet 同步）
#!desc=v3（2026-11-03）：修 v2 的正则多写一个斜杠导致永不匹配。v2 起覆盖 interface3 等子域与 *.music.163.com MITM。设备端哑捕获，幂等/校验/落库全在 Mac。
#!author=ForestofTime
#!category=Automation
#!homepage=https://github.com/ForestofTime/Surge
#!raw-url=https://hynmac-mini.taila66285.ts.net/netease-cookie/module.sgmodule
#!arguments=receiver_url:https://hynmac-mini.taila66285.ts.net/netease-cookie
#!arguments-desc=receiver_url: Mac Tailnet receiver 地址（默认已内置 /netease-cookie）。
#!icon=https://raw.githubusercontent.com/shindgewongxj/WHATINStash/main/icon/netease.png

[Script]
网易云-凭据捕获 = type=http-request,pattern=^https?:\/\/(?:[A-Za-z0-9-]+\.)*(?:music|interface)\d*\.163\.com,requires-body=false,max-size=16384,timeout=30,engine=jsc,script-path=https://hynmac-mini.taila66285.ts.net/netease-cookie/js/NetEaseCookieCapture.js?v=3,script-arguments="receiver_url={{{receiver_url}}}"

[MITM]
hostname = %APPEND% music.163.com, *.music.163.com, interface.music.163.com, interface3.music.163.com
