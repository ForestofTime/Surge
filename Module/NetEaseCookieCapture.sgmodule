#!name=网易云云贝凭据抓取（Tailnet 同步）
#!desc=v1（2026-11-03）：截 music.163.com 的 Cookie 头（MUSIC_U），经 Tailnet receiver 直写青龙并立刻跑一发云贝签到。设备端哑捕获，幂等/校验/落库全在 Mac。
#!author=ForestofTime
#!category=Automation
#!homepage=https://github.com/ForestofTime/Surge
#!raw-url=https://hynmac-mini.taila66285.ts.net/netease-cookie/module.sgmodule
#!arguments=receiver_url:https://hynmac-mini.taila66285.ts.net/netease-cookie
#!arguments-desc=receiver_url: Mac Tailnet receiver 地址（默认已内置 /netease-cookie）。
#!icon=https://raw.githubusercontent.com/shindgewongxj/WHATINStash/main/icon/netease.png

[Script]
网易云-凭据捕获 = type=http-request,pattern=^https?:\/\/(?:[\w-]+\.)?music\.163\.com\//,requires-body=false,max-size=16384,timeout=30,engine=jsc,script-path=https://hynmac-mini.taila66285.ts.net/netease-cookie/js/NetEaseCookieCapture.js?v=1,script-arguments="receiver_url={{{receiver_url}}}"

[MITM]
hostname = %APPEND% music.163.com, interface.music.163.com
