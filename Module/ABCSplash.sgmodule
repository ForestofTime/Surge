#!name=农业银行去开屏广告
#!desc=过滤农行已知开屏素材与全屏图片，保留普通业务图片。v2
#!author=ForestofTime
#!category=AdBlock
#!homepage=https://github.com/ForestofTime/Surge
#!raw-url=https://raw.githubusercontent.com/ForestofTime/Surge/main/Module/ABCSplash.sgmodule
# 合并原 nyyh 的两组已知素材前缀；其它图片按尺寸判断。来源与边界见 docs/abc-adblock-merge.md。

[Map Local]
^https?:\/\/midc\.cdn-static\.abchina\.com\.cn\/distributecenterimg\/file\/download\/(?:ed64|74b5)[0-9a-f]+(?:\?|$) data-type=tiny-gif status-code=200

[Script]
# midc 下发素材图过滤（response 阶段解析图片尺寸）
农行-开屏图过滤 = type=http-response, pattern=^https?:\/\/midc\.cdn-static\.abchina\.com\.cn\/distributecenterimg\/file\/download\/[0-9a-f]+(?:\?|$), requires-body=true, binary-body-mode=true, max-size=1048576, script-path=https://raw.githubusercontent.com/ForestofTime/Surge/main/JS/ABCSplash.js?v=2, timeout=10

[MITM]
hostname = %APPEND% midc.cdn-static.abchina.com.cn
