#!name=工银e生活去开屏广告
#!desc=清理小程序配置与原生 App 缓存开屏，保留正常楼层和业务响应。v2
#!author=ForestofTime
#!category=广告过滤
#!homepage=https://github.com/ForestofTime/Surge
#!raw-url=https://raw.githubusercontent.com/ForestofTime/Surge/agent/icbc-elife-splash-20260809/Module/ICBCLife.sgmodule

[Map Local]
# 原生 App 沿用社区已知的精确曝光像素处理，不触碰任何业务接口。
^https?:\/\/pv\.elife\.icbc\.com\.cn\/OFSTPV\/utm\.gif(?:\?|$) data-type=text data=" " status-code=200

[Body Rewrite]
# HAR 已验证：getStartupMantleFlatingFloor 的 qdp/启动屏 startupDto 是小程序开屏配置。
# 仅清空该数组，保留 WXMP01 蒙屏、JX001 精选页悬浮框及全部响应状态字段。
http-response-jq ^https:\/\/elife\.icbc\.com\.cn\/OFSTNEWBASE\/floorinfo\/getStartupMantleFlatingFloor\.do(?:\?|$) 'if (.data | type) == "array" then .data |= map(if ((.floorId == "qdp" or .floorName == "启动屏") and (.startupDto | type) == "array") then .startupDto = [] else . end) else . end'

[Script]
# 最新 App HAR 未见开屏配置请求，而是直读缓存布局下发的完整画布素材。
# 仅拒绝 1125x2436 的全屏画布，图片名称、活动文案与上传日期变化时仍可生效。
工银e生活App-缓存开屏兜底 = type=http-response, pattern=^https:\/\/image[1-4]\.elife\.icbc\.com\.cn\/filepath\/elife\/.*\.jpe?g(?:\?.*)?$, script-path=https://raw.githubusercontent.com/ForestofTime/Surge/agent/icbc-elife-splash-20260809/JS/ICBCLifeSplashImage.js?v=2, requires-body=true, binary-body-mode=true, max-size=4194304, timeout=10

[MITM]
hostname = %APPEND% elife.icbc.com.cn, pv.elife.icbc.com.cn, image1.elife.icbc.com.cn, image2.elife.icbc.com.cn, image3.elife.icbc.com.cn, image4.elife.icbc.com.cn
