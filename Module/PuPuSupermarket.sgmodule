#!name=朴朴超市去广告
#!desc=过滤 QX 广告接口，并兜底处理当前 PNG 开屏与个人页广告分类。v23
#!author=奶思(原) / ForestofTime Surge 转换
#!category=广告过滤
#!homepage=https://github.com/fmz200/wool_scripts
#!raw-url=https://raw.githubusercontent.com/ForestofTime/Surge/main/Module/PuPuSupermarket.sgmodule

[Map Local]
# 与 QX 抓包中的 REJECT 结果一致，显式返回 404 空响应。
^http:\/\/139\.196\.12\.179:8053\/httpdns\/ data-type=text data="" status-code=404
^http:\/\/106\.55\.220\.18:8053\/httpdns\/ data-type=text data="" status-code=404
^http:\/\/54\.222\.159\.138:8053\/httpdns\/ data-type=text data="" status-code=404
^http:\/\/101\.42\.130\.147\/httpdns\/resolve\/ data-type=text data="" status-code=404

# 我的页面会员卡入口
^https:\/\/j1\.pupuapi\.com\/client\/member_card\/index\/my data-type=text data="" status-code=404

# 搜索框页面热榜
^https:\/\/j1\.pupuapi\.com\/client\/marketing\/advertisement\/search_input_ranking data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# 订单待收货页右下角悬浮广告
^https:\/\/j1\.pupuapi\.com\/client\/assets\/discount\/order data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# 购物车页换购推荐
^https:\/\/j1\.pupuapi\.com\/client\/marketing\/channel\/global_redeem\/top_tip\/v2 data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# 各页面商品推荐
^https:\/\/j1\.pupuapi\.com\/client\/recommendation\/hub\/interests\/products\/v2 data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# 我的页面实惠卡
^https:\/\/j1\.pupuapi\.com\/client\/member_card\/premium\/user_center data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
# Surge 单一宽入口。具体路径在脚本中判定，避免复杂规则未命中。
朴朴-API响应过滤 = type=http-response, pattern=^https:\/\/j1\.pupuapi\.com\/client\/, script-path=https://raw.githubusercontent.com/ForestofTime/Surge/main/JS/PuPuSupermarket.js?v=23, requires-body=true, max-size=1048576, timeout=60

# 当前 App 会直接读取本地开屏配置。源文件后缀会在 PNG 与 JPEG 间变化，响应统一为 WebP。
朴朴-缓存开屏兜底 = type=http-response, pattern=^https:\/\/product-files\.pupumall\.com\/STORE_PRODUCT\/.*\.(?:png|jpe?g)(?:\?.*)?$, script-path=https://raw.githubusercontent.com/ForestofTime/Surge/main/JS/PuPuSplashImage.js?v=23, requires-body=true, binary-body-mode=true, max-size=1048576, timeout=10

# 个人页会从本地配置直接加载广告分类。保留 QX 抓包中的 228x228 功能入口。
朴朴-个人页素材兜底 = type=http-response, pattern=^https:\/\/banner-files\.pupumall\.com\/ADVERTISING_INTERNAL\/.*\.(?:png|jpe?g)(?:\?.*)?$, script-path=https://raw.githubusercontent.com/ForestofTime/Surge/main/JS/PuPuSplashImage.js?v=23, requires-body=true, binary-body-mode=true, max-size=1048576, timeout=10

[MITM]
hostname = %APPEND% j1.pupuapi.com, product-files.pupumall.com, banner-files.pupumall.com
