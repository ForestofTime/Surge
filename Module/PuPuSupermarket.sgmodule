#!name=朴朴超市(抓包修正版)
#!desc=基于 2026-07-21/22/23 多次抓包修正：整容器拦截已确认的开屏广告素材池（与首页 banner 共用），覆盖子路径变化；补全 MITM 子域、删除损坏规则、放宽版本锁。注意：某些APP要清除缓存或者重新安装拦截广告才会生效！
#!author=奶思(原) / WorkBuddy 修正
#!category=奶思的模块
#!homepage=https://github.com/fmz200/wool_scripts
#!raw-url=https://github.com/fmz200/wool_scripts/raw/main/Surge/module/split/partP/PuPuSupermarket.sgmodule
#!tg-channel=https://t.me/inaisi
#!arguments=pupuicui_enable:true

[URL Rewrite]
# 广告下发(httpdns)。注意：抓包显示 54.222.159.138:8053 完成握手未被 reject，
# 说明 app 大概率走直连 socket 做 httpdns，URL Rewrite reject 对直连 socket 不生效，这几条可能无效。
^http:\/\/139\.196\.12\.179:8053\/httpdns\/ - reject
^http:\/\/106\.55\.220\.18:8053\/httpdns\/ - reject
^http:\/\/54\.222\.159\.138:8053\/httpdns\/ - reject
^http:\/\/101\.42\.130\.147\/httpdns\/resolve\/ - reject

# v10 修正：用户选 reject 版。广告容器（开屏与首页 banner 共用同一素材池）整容器 reject，
# 覆盖任意子路径，解决 app 换子路径漏过问题；019cc0d9 的 1ce7/04b5 也按同样策略处理。
# 代价：首页对应 banner/活动位会留白。这是网络层无法区分「开屏用」还是「首页用」导致的取舍。

# 019cc0d9: 开屏+首页共用素材 -> reject(开屏彻底跳过，代价首页留白)
^https:\/\/product-files\.pupumall\.com\/STORE_PRODUCT\/019cc0d94ea573e79e38e471f3d79b83\/1ce7\/4ee39889093d7a6810380abcff659abf\.gif(\?.*)? - reject
^https:\/\/product-files\.pupumall\.com\/STORE_PRODUCT\/019cc0d94ea573e79e38e471f3d79b83\/04b5\/94fd53b8ded7886803ce20ade2213dcf\.png(\?.*)? - reject

# 89c0be43 / 31beb0ed / 12cdc95e / c635cc92 / 0876bb9f / 7edc759f: 广告容器 -> 容器级 reject(gif/mp4/png/jpg/webp 全格式)
^https:\/\/product-files\.pupumall\.com\/STORE_PRODUCT\/89c0be43a77a4204aceed273bffb5424\/[0-9a-f]+\/[0-9a-f]+\.(?:gif|mp4|png|jpg|jpeg|webp)(\?.*)? - reject

^https:\/\/product-files\.pupumall\.com\/STORE_PRODUCT\/31beb0ed84fc482ab443633b6f4866c2\/[0-9a-f]+\/[0-9a-f]+\.(?:gif|mp4|png|jpg|jpeg|webp)(\?.*)? - reject

^https:\/\/product-files\.pupumall\.com\/STORE_PRODUCT\/12cdc95e7dfb4eaa822914c9e7cb4264\/[0-9a-f]+\/[0-9a-f]+\.(?:gif|mp4|png|jpg|jpeg|webp)(\?.*)? - reject

^https:\/\/product-files\.pupumall\.com\/STORE_PRODUCT\/c635cc92742040c6b16a85d8e9efbaeb\/[0-9a-f]+\/[0-9a-f]+\.(?:gif|mp4|png|jpg|jpeg|webp)(\?.*)? - reject

# 2026-07-23 新增：大暑节气新 campaign 容器（抓包 154123.har）
^https:\/\/product-files\.pupumall\.com\/STORE_PRODUCT\/0876bb9f23bd4d2789adae816be7cdcd\/[0-9a-f]+\/[0-9a-f]+\.(?:gif|mp4|png|jpg|jpeg|webp)(\?.*)? - reject

^https:\/\/product-files\.pupumall\.com\/STORE_PRODUCT\/7edc759f51f8452db7a8432387b3b214\/[0-9a-f]+\/[0-9a-f]+\.(?:gif|mp4|png|jpg|jpeg|webp)(\?.*)? - reject

# 主页实惠卡横幅
^https:\/\/j1\.pupuapi\.com\/client\/member_card\/index\/my - reject

[Rule]
# v10 备份拦截：若 URL Rewrite 未命中，对所有已知广告容器兜底 REJECT。
# 这些容器与首页 banner 共用素材池，reject 会导致首页部分位置留白。
URL-REGEX,^https:\/\/product-files\.pupumall\.com\/STORE_PRODUCT\/019cc0d94ea573e79e38e471f3d79b83\/(1ce7|04b5)\/,REJECT
URL-REGEX,^https:\/\/product-files\.pupumall\.com\/STORE_PRODUCT\/89c0be43a77a4204aceed273bffb5424\/,REJECT
URL-REGEX,^https:\/\/product-files\.pupumall\.com\/STORE_PRODUCT\/31beb0ed84fc482ab443633b6f4866c2\/,REJECT
URL-REGEX,^https:\/\/product-files\.pupumall\.com\/STORE_PRODUCT\/12cdc95e7dfb4eaa822914c9e7cb4264\/,REJECT
URL-REGEX,^https:\/\/product-files\.pupumall\.com\/STORE_PRODUCT\/c635cc92742040c6b16a85d8e9efbaeb\/,REJECT
URL-REGEX,^https:\/\/product-files\.pupumall\.com\/STORE_PRODUCT\/0876bb9f23bd4d2789adae816be7cdcd\/,REJECT
URL-REGEX,^https:\/\/product-files\.pupumall\.com\/STORE_PRODUCT\/7edc759f51f8452db7a8432387b3b214\/,REJECT

[Body Rewrite]
http-response-jq ^https:\/\/j1\.pupuapi\.com\/client\/notification\/message_center\/unread_number '.data = []'

[Map Local]
# 搜索框页面热榜
^https:\/\/j1\.pupuapi\.com\/client\/marketing\/advertisement\/search_input_ranking data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# 朴朴超市订单待收货页右下角悬浮广告
^https:\/\/j1\.pupuapi\.com\/client\/assets\/discount\/order data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# 购物车页去换购推荐
^https:\/\/j1\.pupuapi\.com\/client\/marketing\/channel\/global_redeem\/top_tip\/v2 data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# 各种页面的商品推荐
^https:\/\/j1\.pupuapi\.com\/client\/recommendation\/hub\/interests\/products\/v2 data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# 个人主页会员标识
^https:\/\/j1\.pupuapi\.com\/client\/member_card\/premium\/user_center data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
# 搜索热词(放宽版本锁, 去掉 /v3)
朴朴超市 = type=http-response, pattern=^https:\/\/j1\.pupuapi\.com\/client\/search\/hot_keywords, script-path=https://raw.githubusercontent.com/ForestofTime/Surge/main/JS/PuPuSupermarket.js, requires-body=true, timeout=60

# 原模块此处有一条损坏规则: ^https:\/\/j1\.pupuapi\.com\/client\/a朴朴超市, (含中文与逗号, 永不匹配, 已删除)
# 若你知道开屏广告的真实端点, 可在此补回一条正确规则。

# 广告 v1(放宽版本锁, 去掉 /v1; 由脚本内部 /advertisement 匹配任意版本)
朴朴超市 = type=http-response, pattern=^https:\/\/j1\.pupuapi\.com\/client\/marketing\/advertisement, script-path=https://raw.githubusercontent.com/ForestofTime/Surge/main/JS/PuPuSupermarket.js, requires-body=true, timeout=60

# 搜索结果页信息流横幅广告(放宽版本锁, 去掉 /v6)
朴朴超市 = type=http-response, pattern=^https:\/\/j1\.pupuapi\.com\/client\/search\/hub\/search_box\/products, script-path=https://raw.githubusercontent.com/ForestofTime/Surge/main/JS/PuPuSupermarket.js, requires-body=true, timeout=60

# 下单页实惠卡开通推荐
朴朴超市 = type=http-response, pattern=^https:\/\/j1\.pupuapi\.com\/client\/order_settlement\/detail, script-path=https://raw.githubusercontent.com/ForestofTime/Surge/main/JS/PuPuSupermarket.js, requires-body=true, timeout=60

# 订单列表骑手反馈问题推荐(放宽版本锁, 去掉 /v4)
朴朴超市 = type=http-response, pattern=^https:\/\/j1\.pupuapi\.com\/client\/order\/orders\/list, script-path=https://raw.githubusercontent.com/ForestofTime/Surge/main/JS/PuPuSupermarket.js, requires-body=true, timeout=60

# 补全脚本里存在但原模块遗漏的端点(原脚本有 /resource_preload/list_h5_resource 分支, 却无对应规则)
朴朴超市 = type=http-response, pattern=^https:\/\/j1\.pupuapi\.com\/client\/resource_preload\/list_h5_resource, script-path=https://raw.githubusercontent.com/ForestofTime/Surge/main/JS/PuPuSupermarket.js, requires-body=true, timeout=60

# 2026-07-23 v10 修正（用户选 reject 版）：
# 1) 6 个广告容器整容器 reject(覆盖任意子路径) + 019cc0d9/1ce7/04b5 按文件级 reject。
# 2) 2026-07-23 新增大暑 campaign 容器 0876bb9f、7edc759f（抓包 154123.har）。
# 3) 目的：让开屏广告背景图加载失败 -> app 跳过整个开屏(含按钮/倒计时)。
# 4) 代价：这些容器与首页 banner/活动位共用素材池，reject 会导致首页对应位置留白。
# 5) 开屏广告是「原生容器 + 背景图」，reject 背景图即可让 app 放弃开屏。只要 app 继续复用首页 banner 图做开屏，这个取舍就 unavoidable。

[MITM]
# 抓包显示 app 还连了以下子域并已被 MITM, 一并纳入以便后续规则可拦截
# 2026-07-22 追加 imgs.pupuapi.com（天气/活动图标素材域，备用）
hostname = %APPEND% j1.pupuapi.com, owl.pupuapi.com, pwy.pupuapi.com, push.pupuapi.com, product-files.pupumall.com, marketing-files.pupumall.com, imgs.pupuapi.com
