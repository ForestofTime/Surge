#!name=中国移动心愿金凭据抓取（Tailnet 同步）
#!desc=捕获小程序 wmhsso JWT，经 Tailnet 写青龙 cmcc_mini 三端签到。v2
#!author=ForestofTime
#!category=Automation
#!homepage=https://github.com/ForestofTime/Surge
#!raw-url=https://raw.githubusercontent.com/ForestofTime/Surge/main/Module/CMCCMiniCapture.sgmodule
#!arguments=receiver_url:https://hynmac-mini.taila66285.ts.net/cmcc-mini
#!arguments-desc=receiver_url: Mac Tailnet receiver 地址（默认已内置 hynmac-mini/cmcc-mini，一般无需修改）。凭据按 openid 合并写入青龙 env cmcc_mini。
#!icon=https://raw.githubusercontent.com/shindgewongxj/WHATINStash/main/icon/cmcc.png

[Script]
中国移动-心愿金凭据捕获 = type=http-request,pattern=^https?:\/\/wx\.online-cmcc\.cn\/wmhnewcenter\/(?:alipay-applet|wechat86-applet)\/wmhsso(?:\?.*)?$,requires-body=false,timeout=60,engine=jsc,script-path=https://raw.githubusercontent.com/ForestofTime/Surge/main/JS/CMCCMiniCapture.js?v=3,script-arguments="receiver_url={{{receiver_url}}}"

[MITM]
hostname = %APPEND% wx.online-cmcc.cn
