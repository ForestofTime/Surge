[General]
# 夸克/UC 全域名族走真实 IP: fake-IP 映射被淘汰后客户端仍会缓存旧 fake-IP 并无限重试
# (Unknown VIF virtual IP 风暴, 2026-09-22 两次触发 Surge 重启), real-IP 从根上消除该形态。
# 附带收益: 长连接不再因映射刷新被切断。
always-real-ip = %APPEND% *.quark.cn, *.uc.cn, quark.cn, uc.cn

[Rule]
# v1 保留: 已观测广告 SDK 域名, 失败后的高频重试风暴抑制 (域名级, pre-matching)
DOMAIN,api-access.pangolin-sdk-toutiao.com,REJECT,pre-matching
