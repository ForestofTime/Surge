#!name=菜鸟淘宝小程序去广告
#!desc=选择性清理菜鸟淘宝小程序 HTTPDNS，以成功空响应替代广告请求并过滤悬浮结构，避免网络失败回退旧广告缓存。v9
#!author=ForestofTime
#!category=AdBlock
#!homepage=https://github.com/ForestofTime/Surge
#!raw-url=https://raw.githubusercontent.com/ForestofTime/Surge/main/Module/CainiaoMiniProgram.sgmodule

[Rule]
# 主请求只禁用 QUIC，使 mshow 的业务入口经可改写的 TCP HTTP 引擎返回；全协议拒绝会触发客户端复用旧广告缓存。
AND,((DOMAIN,netflow-mtop.cainiao.com,extended-matching),(PROTOCOL,QUIC)),REJECT
# 专用 reply 主机没有正常包裹业务，继续预匹配全协议阻断响应旁路。
DOMAIN,netflow-reply-mtop.cainiao.com,REJECT,extended-matching,pre-matching

[Script]
# 仅处理菜鸟淘宝小程序 appkey。响应为 base64 JSON 时保持 base64 编码，只移除五个已确认的 MTop 直连域名。
菜鸟小程序-HTTPDNS清理 = type=http-response, pattern=^https?:\/\/(?:amdc\.m\.taobao\.com|(?:\d+\.){3}\d+)(?::\d+)?\/amdc\/mobileDispatch\?(?:[^&#]*&)*appkey=21380790(?:&[^#]*)?$, script-path=https://raw.githubusercontent.com/ForestofTime/Surge/main/JS/CainiaoMiniProgram.js?v=9, requires-body=true, max-size=1048576, timeout=10

# show、show.login 与 batch.show 在发网前返回标准 MTop 成功空响应，阻止 FAIL_SYS_NETWORK_ERROR 触发持久缓存回退。
菜鸟小程序-广告请求置空 = type=http-request, pattern=^https?:\/\/(?:guide-acs\.m\.taobao\.com|acs4miniapp-inner\.m\.taobao\.com|guide-acs4miniapp-inner\.m\.taobao\.com|acs\.m\.taobao\.com|netflow-mtop\.cainiao\.com|netflow-reply-mtop\.cainiao\.com)\/gw\/mtop\.cainiao\.guoguo\.nbnetflow\.ads\.(?:show(?:\.login)?|batch\.show)(?:\/|\?|$), script-path=https://raw.githubusercontent.com/ForestofTime/Surge/main/JS/CainiaoMiniProgram.js?v=9, timeout=10

# mshow 保留取件、寄件等业务数组，只移除带 floatview 展示结构的悬浮广告；其余广告接口响应继续作为回退兜底。
菜鸟小程序-广告位过滤 = type=http-response, pattern=^https?:\/\/(?:guide-acs\.m\.taobao\.com|acs4miniapp-inner\.m\.taobao\.com|guide-acs4miniapp-inner\.m\.taobao\.com|acs\.m\.taobao\.com|netflow-mtop\.cainiao\.com|netflow-reply-mtop\.cainiao\.com)\/gw\/mtop\.cainiao\.guoguo\.nbnetflow\.ads\.(?:mshow(?:\.cn)?|show(?:\.login)?|batch\.show)(?:\/|\?|$), script-path=https://raw.githubusercontent.com/ForestofTime/Surge/main/JS/CainiaoMiniProgram.js?v=9, requires-body=true, max-size=1048576, timeout=10

[MITM]
hostname = %APPEND% guide-acs.m.taobao.com, acs4miniapp-inner.m.taobao.com, guide-acs4miniapp-inner.m.taobao.com, acs.m.taobao.com, netflow-mtop.cainiao.com, netflow-reply-mtop.cainiao.com
# HTTPDNS 缓存可能使 MTop 走 Type 3 原始 TLS，限定由上方六个 hostname 进入 HTTP 引擎。
tcp-connection = true
