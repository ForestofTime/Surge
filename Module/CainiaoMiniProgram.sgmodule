#!name=菜鸟淘宝小程序去广告
#!desc=选择性清理菜鸟淘宝小程序 HTTPDNS，全协议阻断广告专用主机，并按广告接口结构清空广告位，保留包裹数据。v8
#!author=ForestofTime
#!category=AdBlock
#!homepage=https://github.com/ForestofTime/Surge
#!raw-url=https://raw.githubusercontent.com/ForestofTime/Surge/main/Module/CainiaoMiniProgram.sgmodule

[Rule]
# 两个抓包确认的广告专用主机在 HTTPDNS 已清理后仍可能通过隐藏原生通道或持久连接送达，预匹配阶段全协议阻断。
DOMAIN,netflow-mtop.cainiao.com,REJECT,extended-matching,pre-matching
DOMAIN,netflow-reply-mtop.cainiao.com,REJECT,extended-matching,pre-matching

[Script]
# 仅处理菜鸟淘宝小程序 appkey。响应为 base64 JSON 时保持 base64 编码，只移除五个已确认的 MTop 直连域名。
菜鸟小程序-HTTPDNS清理 = type=http-response, pattern=^https?:\/\/(?:amdc\.m\.taobao\.com|(?:\d+\.){3}\d+)(?::\d+)?\/amdc\/mobileDispatch\?(?:[^&#]*&)*appkey=21380790(?:&[^#]*)?$, script-path=https://raw.githubusercontent.com/ForestofTime/Surge/main/JS/CainiaoMiniProgram.js?v=8, requires-body=true, max-size=1048576, timeout=10

# 仅改写 mshow、show、show.login 与 batch.show 广告响应。按广告接口的数字位数组或 result 数组清空，不依赖坑位、素材、文案和活动标识。
菜鸟小程序-广告位过滤 = type=http-response, pattern=^https?:\/\/(?:guide-acs\.m\.taobao\.com|acs4miniapp-inner\.m\.taobao\.com|guide-acs4miniapp-inner\.m\.taobao\.com|acs\.m\.taobao\.com|netflow-mtop\.cainiao\.com|netflow-reply-mtop\.cainiao\.com)\/gw\/mtop\.cainiao\.guoguo\.nbnetflow\.ads\.(?:mshow(?:\.cn)?|show(?:\.login)?|batch\.show)(?:\/|\?|$), script-path=https://raw.githubusercontent.com/ForestofTime/Surge/main/JS/CainiaoMiniProgram.js?v=8, requires-body=true, max-size=1048576, timeout=10

[MITM]
hostname = %APPEND% guide-acs.m.taobao.com, acs4miniapp-inner.m.taobao.com, guide-acs4miniapp-inner.m.taobao.com, acs.m.taobao.com, netflow-mtop.cainiao.com, netflow-reply-mtop.cainiao.com
# HTTPDNS 缓存可能使 MTop 走 Type 3 原始 TLS，限定由上方六个 hostname 进入 HTTP 引擎。
tcp-connection = true
